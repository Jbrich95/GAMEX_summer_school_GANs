def log_quantile_rmse(sample, probs):
    q_hat = np.quantile(sample, probs)
    q_true = burr_quantile(probs)

    return np.sqrt(
        np.mean(
            (
                np.log(np.maximum(q_hat, 1e-12))
                -
                np.log(q_true)
            ) ** 2
        )
    )

