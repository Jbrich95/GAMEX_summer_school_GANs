def burr_quantile(u, gamma=gamma, rho=rho):
    u = np.asarray(u)
    c = -rho / gamma
    d_burr = -1.0 / rho
    return ((1.0 - u) ** (-1.0 / d_burr) - 1.0) ** (1.0 / c)

